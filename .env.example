# Backend (export these before `mvn spring-boot:run`, or set them in your IDE run config)
DB_URL=jdbc:mysql://localhost:3306/smart_study_planner?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_EXPIRATION_MS=86400000
CORS_ORIGIN=http://localhost:5173
SEED_DEMO=false
# Frontend (frontend/.env, optional)
VITE_API_URL=/api
